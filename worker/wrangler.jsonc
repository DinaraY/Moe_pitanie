{
  "name": "moe-pitanie-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://dinaray.github.io",
    "CATALOG_ENABLED": "false"
  },
  "ratelimits": [{
    "name": "CATALOG_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}
